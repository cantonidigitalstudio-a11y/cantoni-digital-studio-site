  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site/issues"
  },
  "homepage": "https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site#readme",
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
