{
  "name": "cantoni_site",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "build:cloudflare": "bash scripts/build_cloudflare_public_dir.sh",
    "build:business-card": "node scripts/render_business_card_assets.cjs",
    "build:social": "node sales-kit/scripts/render_social_launch_assets.mjs && node sales-kit/scripts/render_social_cover_assets.mjs",
    "build:social:daily": "npm run build:social && node sales-kit/scripts/export_daily_social_pack.mjs",
    "build:social:video": "node sales-kit/scripts/export_video_storyboard_pack.mjs",
    "build:social:short": "node sales-kit/scripts/render_daily_short_video_asset.mjs",
    "build:social:carousel": "node sales-kit/scripts/export_tiktok_carousel_pack.mjs",
    "build:social:voice-review": "node sales-kit/scripts/discover_voice_reference_candidates.mjs",
    "build:social:pack": "npm run build:social && node sales-kit/scripts/export_social_publish_pack.mjs && npm run build:social:daily && npm run build:social:video",
    "build:cloudflare-upload-package": "node scripts/export_cloudflare_manual_upload_package.cjs",
    "export:launch-handoff": "node scripts/export_launch_handoff.cjs",
    "export:email-dns-handoff": "node scripts/export_email_dns_handoff.cjs",
    "dns:cloudflare:plan": "node scripts/sync_cloudflare_email_dns.cjs --dry-run",
    "dns:cloudflare:apply": "node scripts/sync_cloudflare_email_dns.cjs --apply",
    "export:live-drift": "node scripts/export_live_drift_report.cjs",
    "export:launch-operator-pack": "node scripts/export_launch_operator_pack.cjs",
    "build:lead-batch": "LEAD_PIPELINE_CSV=sales-kit/fixtures/lead-batches/sanitized-starter/leads.csv OUTREACH_QUEUE_FILE=sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue.json node sales-kit/scripts/build_outreach_queue_from_csv.mjs",
    "build:lead-batch:micro": "OUTREACH_STYLE=micro_audit LEAD_PIPELINE_CSV=sales-kit/fixtures/lead-batches/sanitized-starter/leads.csv OUTREACH_QUEUE_FILE=sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue_micro.json node sales-kit/scripts/build_outreach_queue_from_csv.mjs",
    "build:branded-outreach": "npm run build:lead-batch && OUTREACH_QUEUE_FILE=sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue.json BRANDED_OUTREACH_DIR=sales-kit/generated/outreach-fixtures/sanitized-starter/branded node sales-kit/scripts/render_branded_outreach_emails.mjs",
    "build:global-outreach": "LEAD_PIPELINE_CSV=sales-kit/lead-batches/2026-05-15-global-50/leads.csv OUTREACH_QUEUE_FILE=sales-kit/lead-batches/2026-05-15-global-50/outreach_queue.json node sales-kit/scripts/build_outreach_queue_from_csv.mjs && OUTREACH_QUEUE_FILE=sales-kit/lead-batches/2026-05-15-global-50/outreach_queue.json BRANDED_OUTREACH_DIR=sales-kit/lead-batches/2026-05-15-global-50/branded node sales-kit/scripts/render_branded_outreach_emails.mjs",
    "build:global-followup-d3": "FOLLOWUP_TARGET_DATE=2026-05-22 LEAD_PIPELINE_CSV=sales-kit/lead-batches/2026-05-15-global-50/leads.csv FOLLOWUP_QUEUE_FILE=sales-kit/lead-batches/2026-05-15-global-50/followup_d3_queue.json node sales-kit/scripts/build_followup_d3_queue_from_csv.mjs",
    "build:global-followup-review": "npm run build:global-followup-d3 && FOLLOWUP_QUEUE_FILE=sales-kit/lead-batches/2026-05-15-global-50/followup_d3_queue.json node sales-kit/scripts/render_followup_review.mjs",
    "device:samsung:reconnect": "bash scripts/samsung_wireless_reconnect.sh",
    "test:device:samsung": "npm run device:samsung:reconnect",
    "outreach:background": "node sales-kit/scripts/gmail_background_worker.mjs",
    "test": "npm run test:i18n && npm run test:integrity && npm run test:smoke",
    "test:vip": "cd ../excellentia-vip-site && npm test",
    "test:vip-account": "cd ../excellentia-vip-site && npm run test:vip-local-flow",
    "test:vip-cross-page": "cd ../excellentia-vip-site && npm run test:vip-cross-page",
    "test:vip-interactions": "cd ../excellentia-vip-site && npm run test:vip-local-flow",
    "test:vip-server": "cd ../excellentia-vip-site && npm run test:vip-local-flow",
    "test:payments": "node scripts/verify_payment_links.cjs",
    "test:browser": "node scripts/browser_site_smoke.cjs",
    "test:live-site": "node scripts/verify_live_site.cjs",
    "test:deploy-policy": "node scripts/verify_deploy_channel_policy.cjs",
    "test:artifact": "node scripts/verify_deploy_artifact.cjs",
    "test:browser:artifact": "SITE_ROOT=.cloudflare-pages npm run test:browser",
    "test:payments:artifact": "SITE_ROOT=.cloudflare-pages npm run test:payments",
    "test:launch-handoff-artifacts": "node scripts/verify_launch_handoff_artifacts.cjs",
    "test:lead-batch": "LEAD_BATCH_CSV=sales-kit/fixtures/lead-batches/sanitized-starter/leads.csv node sales-kit/scripts/verify_global_starter_batch.mjs",
    "test:global-outreach": "LEAD_BATCH_CSV=sales-kit/lead-batches/2026-05-15-global-50/leads.csv npm run test:outreach-dedupe && node sales-kit/scripts/verify_global_outreach_batch.mjs --csv sales-kit/lead-batches/2026-05-15-global-50/leads.csv --max-ready-per-run 10 --max-rows 60 && npm run build:global-outreach && npm run test:outreach-queue-quality && npm run test:proposal-personalization",
    "test:global-followup-d3": "npm run build:global-followup-review && FOLLOWUP_QUEUE_FILE=sales-kit/lead-batches/2026-05-15-global-50/followup_d3_queue.json node sales-kit/scripts/verify_followup_queue.mjs --allow-empty && FOLLOWUP_TARGET_DATE=2026-05-22 LEAD_PIPELINE_CSV=sales-kit/lead-batches/2026-05-15-global-50/leads.csv node sales-kit/scripts/verify_global_followup_state.mjs",
    "test:proposal-personalization": "node sales-kit/scripts/verify_proposal_personalization.mjs --csv sales-kit/lead-batches/2026-05-15-global-50/leads.csv",
    "test:outreach-dedupe": "node sales-kit/scripts/verify_outreach_no_recent_duplicates.mjs",
    "test:outreach-queue-quality": "node sales-kit/scripts/verify_outreach_queue_quality.mjs --queue sales-kit/lead-batches/2026-05-15-global-50/outreach_queue.json --allow-empty",
    "test:outreach-micro": "npm run build:lead-batch:micro && OUTREACH_QUALITY_STYLE=micro_audit node sales-kit/scripts/verify_outreach_queue_quality.mjs --queue sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue_micro.json",
    "test:outreach-deliverability": "npm run build:lead-batch:micro && node sales-kit/scripts/verify_outreach_deliverability.mjs --queue sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue_micro.json",
    "test:reply-to-quote": "rm -rf /tmp/cantoni-reply-test && mkdir -p /tmp/cantoni-reply-test && LEAD_PIPELINE_CSV=sales-kit/lead-batches/2026-05-15-global-50/leads.csv REPLIES_INBOX_FILE=sales-kit/fixtures/reply_to_quote_sample.json REPLY_DRAFTS_DIR=/tmp/cantoni-reply-test/reply-drafts QUOTE_INPUT_OUTPUT_DIR=/tmp/cantoni-reply-test/quote-inputs node sales-kit/scripts/process_reply_inbox.mjs --dry-run && node sales-kit/scripts/generate_personalized_quote.mjs --input /tmp/cantoni-reply-test/quote-inputs/hotel-boutique-at-grand-central-usa-ld-g50-0002.json --output-dir /tmp/cantoni-reply-test/generated",
    "test:lead-endpoint": "node scripts/verify_lead_capture_endpoint.cjs",
    "test:starter-queue": "npm run build:lead-batch && OUTREACH_QUEUE_FILE=sales-kit/generated/outreach-fixtures/sanitized-starter/outreach_queue.json node sales-kit/scripts/verify_cold_outreach_contract.mjs",
    "test:branded-outreach": "npm run build:branded-outreach && node sales-kit/scripts/verify_outreach_branding.mjs --allow-empty --html=sales-kit/generated/outreach-fixtures/sanitized-starter/branded/internal-review-branded.html --queue=sales-kit/generated/outreach-fixtures/sanitized-starter/branded/outreach_queue_branded.json",
    "test:social": "npm run build:social:pack && node sales-kit/scripts/verify_social_launch_assets.mjs && npm run test:social:publish && npm run test:social:daily && npm run test:social:video && npm run test:social:carousel && npm run test:social:voice",
    "test:social:publish": "node sales-kit/scripts/verify_social_publish_pack.mjs",
    "test:social:daily": "npm run build:social:daily && node sales-kit/scripts/verify_daily_social_calendar.mjs",
    "test:social:video": "node sales-kit/scripts/verify_portfolio_content_registry.mjs && npm run build:social:video",
    "test:social:short": "node sales-kit/scripts/verify_daily_short_video_asset.mjs",
    "test:social:carousel": "npm run build:social:carousel && node sales-kit/scripts/verify_tiktok_carousel_pack.mjs",
    "test:social:voice": "node sales-kit/scripts/verify_voiceover_protocol.mjs",
    "test:social-public": "node scripts/verify_public_channels.cjs",
    "test:quote-audit-standard": "node scripts/verify_quote_audit_standard.cjs",
    "test:outreach-readiness": "npm run test:outreach-dedupe && npm run test:branded-outreach && npm run test:outreach-deliverability && npm run test:social-public && npm run test:lead-endpoint && npm run test:quote-audit-standard && npm run test:reply-to-quote && node scripts/verify_cascade_readiness.cjs",
    "test:outreach-sprint": "npm run test:outreach-dedupe && npm run test:outreach-deliverability && npm run test:quote-audit-standard && git diff --check",
    "audit:email-dns": "node sales-kit/scripts/verify_cantoni_email_dns.mjs",
    "test:email-dns-audit": "node sales-kit/scripts/verify_cantoni_email_dns.mjs --allow-missing",
    "test:cloudflare-email-dns-plan": "node scripts/verify_cloudflare_email_dns_plan.cjs",
    "audit:cloudflare-api": "node scripts/verify_cloudflare_api_credentials.mjs",
    "test:cloudflare-api-audit": "node scripts/verify_cloudflare_api_credentials.mjs --allow-missing",
    "test:cloudflare-api-contract": "node scripts/verify_cloudflare_api_credentials_contract.cjs",
    "test:cloudflare-direct-deploy-contract": "node scripts/verify_cloudflare_direct_deploy_contract.cjs",
    "audit:cloudflare-auth": "node scripts/verify_cloudflare_deploy_auth.mjs",
    "test:cloudflare-auth-audit": "node scripts/verify_cloudflare_deploy_auth.mjs --allow-missing",
    "audit:launch-readiness": "node scripts/verify_launch_readiness.mjs",
    "test:launch-readiness-audit": "node scripts/verify_launch_readiness.mjs --allow-blocked",
    "test:market-readiness": "npm run test:full && npm run test:live-site && npm run test:social-public && npm run test:lead-endpoint",
    "test:full": "npm test && npm run test:payments && npm run test:browser && npm run test:deploy-policy && npm run test:email-dns-audit && npm run test:cloudflare-api-audit && npm run test:cloudflare-api-contract && npm run test:cloudflare-direct-deploy-contract && npm run test:cloudflare-email-dns-plan && npm run test:social && npm run test:lead-batch && npm run test:starter-queue && npm run test:branded-outreach && npm run test:outreach-micro && npm run test:outreach-deliverability && npm run build:cloudflare && npm run test:artifact && npm run test:browser:artifact && npm run test:payments:artifact && npm run export:launch-operator-pack && npm run test:launch-handoff-artifacts && git diff --check",
    "test:full:with-vip": "npm run test:full && npm run test:vip",
    "deploy:cloudflare": "bash scripts/deploy_cloudflare_pages.sh",
    "deploy:cloudflare:direct": "bash scripts/deploy_cloudflare_pages_direct.sh",
    "test:i18n": "node scripts/check_i18n.cjs",
    "test:integrity": "node scripts/verify_site_integrity.cjs",
    "test:smoke": "node scripts/smoke_site.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site.git"
  },
  "keywords": [],
