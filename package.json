{
  "name": "cantoni_site",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "build:cloudflare": "bash scripts/build_cloudflare_public_dir.sh",
    "build:business-card": "node scripts/render_business_card_assets.cjs",
    "build:social": "node sales-kit/scripts/render_social_launch_assets.mjs",
    "build:social:pack": "npm run build:social && node sales-kit/scripts/export_social_publish_pack.mjs",
    "build:lead-batch": "LEAD_PIPELINE_CSV=sales-kit/lead-batches/2026-05-11-global-starter/leads.csv OUTREACH_QUEUE_FILE=sales-kit/lead-batches/2026-05-11-global-starter/outreach_queue.json node sales-kit/scripts/build_outreach_queue_from_csv.mjs",
    "build:branded-outreach": "npm run build:lead-batch && node sales-kit/scripts/render_branded_outreach_emails.mjs",
    "test": "npm run test:i18n && npm run test:integrity && npm run test:smoke",
    "test:vip": "npm run test:vip-cross-page && npm run test:vip-interactions && npm run test:vip-account && npm run test:vip-server",
    "test:vip-account": "node scripts/verify_vip_account_flow.cjs",
    "test:vip-cross-page": "node scripts/verify_vip_cross_page.cjs",
    "test:vip-interactions": "node scripts/verify_vip_interactions.cjs",
    "test:vip-server": "node scripts/verify_vip_server_logic.cjs",
    "test:payments": "node scripts/verify_payment_links.cjs",
    "test:browser": "node scripts/browser_site_smoke.cjs",
    "test:artifact": "node scripts/verify_deploy_artifact.cjs",
    "test:browser:artifact": "SITE_ROOT=.cloudflare-pages npm run test:browser",
    "test:payments:artifact": "SITE_ROOT=.cloudflare-pages npm run test:payments",
    "test:lead-batch": "node sales-kit/scripts/verify_global_starter_batch.mjs",
    "test:starter-queue": "npm run build:lead-batch && OUTREACH_QUEUE_FILE=sales-kit/lead-batches/2026-05-11-global-starter/outreach_queue.json node sales-kit/scripts/verify_cold_outreach_contract.mjs",
    "test:branded-outreach": "npm run build:branded-outreach && node sales-kit/scripts/verify_outreach_branding.mjs --html=sales-kit/lead-batches/2026-05-11-global-starter/branded/LD-GS-0001-email.html,sales-kit/lead-batches/2026-05-11-global-starter/branded/LD-GS-0002-email.html,sales-kit/lead-batches/2026-05-11-global-starter/branded/internal-review-branded.html --queue=sales-kit/lead-batches/2026-05-11-global-starter/branded/outreach_queue_branded.json",
    "test:social": "npm run build:social && node sales-kit/scripts/verify_social_launch_assets.mjs",
    "test:full": "npm test && npm run test:payments && npm run test:browser && npm run test:vip && npm run test:social && npm run test:lead-batch && npm run test:starter-queue && npm run test:branded-outreach && npm run build:cloudflare && npm run test:artifact && npm run test:browser:artifact && npm run test:payments:artifact && git diff --check",
    "deploy:cloudflare": "bash scripts/deploy_cloudflare_pages.sh",
    "test:i18n": "node scripts/check_i18n.cjs",
    "test:integrity": "node scripts/verify_site_integrity.cjs",
    "test:smoke": "node scripts/smoke_site.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site/issues"
  },
  "homepage": "https://github.com/cantonidigitalstudio-a11y/cantoni-digital-studio-site#readme",
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
